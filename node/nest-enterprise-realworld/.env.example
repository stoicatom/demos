# 应用环境与端口
NODE_ENV=development
PORT=3000

# 数据库配置 (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_DATABASE=nest_enterprise_db

# Redis 配置 (7.x)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 鉴权与双令牌配置
JWT_SECRET=super_secret_jwt_access_token_key_for_nest_2026
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_for_nest_2026
JWT_REFRESH_EXPIRATION=7d
