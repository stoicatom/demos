# memos 部署环境变量模板
# 用法: 复制为 .env 后按需修改 —— cp .env.example .env
# 注意: .env 不纳入 git(见 .gitignore),真实值仅存在于远端 /opt/memos/

# 容器对外发布端口(绑定到 172.17.0.1)
MEMOS_PORT=5230

# 端口绑定网卡 —— 生产务必保持 172.17.0.1,切勿改成 0.0.0.0(会绕过云防火墙暴露公网)
BIND_HOST=172.17.0.1

# ---- 以下仅用于 nginx 反代配置替换,部署时按实际填写 ----
# memos 访问域名,如 memos.example.com
MEMOS_DOMAIN=memos.example.com
# 泛域名证书目录名,在服务器执行 `ls /var/www/nginx/certificates/` 查得
CERT_DIR=cert-xxxxxxxxxxxx
